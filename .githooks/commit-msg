#!/usr/bin/env bash
# Ambition commit-msg：Conventional Commits 规范（docs/01-engineering §2）
set -euo pipefail
msg_file="$1"
first_line="$(head -n1 "$msg_file")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9-]+\))?!?: .+'
if ! printf '%s' "$first_line" | grep -qE "$pattern"; then
  printf '[commit-msg] ✗ 首行不符合 Conventional Commits：\n  %s\n  正确示例：feat(grader): 规则判题填空支持\n' "$first_line"
  exit 1
fi
